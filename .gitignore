# ─── Root .gitignore for Sanab Monorepo ────────────────────────────────────────

# ── Environment Variables (NEVER commit secrets) ──────────────────────────────
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
.env.test
**/.env
**/.env.*
**/.env.local

# ── Node ──────────────────────────────────────────────────────────────────────
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# ── Next.js ───────────────────────────────────────────────────────────────────
**/.next/
**/out/
**/build/

# ── TypeScript ────────────────────────────────────────────────────────────────
**/*.tsbuildinfo
**/next-env.d.ts

# ── Backend dist ──────────────────────────────────────────────────────────────
backend/dist/

# ── Logs ──────────────────────────────────────────────────────────────────────
**/logs/
**/*.log

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel
