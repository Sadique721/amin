# ─────────────────────────────────────────────────────────────────
# SANAB E-Commerce Platform — Environment Variables (.env.example)
# NEVER commit real secrets to version control.
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── Application Configuration ─────────────────────────────────────
PORT=2800
NODE_ENV=development
APP_NAME=SANAB
APP_URL=http://localhost:2800
FRONTEND_URL=http://localhost:3000
TIMEZONE=Asia/Kolkata
SERVER_PORT=2800

# ── Aiven PostgreSQL Cloud Database ────────────────────────────────
DATABASE_URL=postgres://avnadmin:password@pg-3383bbf0-entitykart.l.aivencloud.com:13332/defaultdb?sslmode=require
DB_HOST=pg-3383bbf0-entitykart.l.aivencloud.com
DB_PORT=13332
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
DB_SSL_MODE=require

# ── Redis Cache & Token Blacklist ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=2637
REDIS_URL=redis://localhost:2637
REDIS_PASSWORD=

# ── Apache Kafka Broker ───────────────────────────────────────────
KAFKA_BROKERS=localhost:2909
KAFKA_BOOTSTRAP_SERVERS=localhost:2909
KAFKA_CLIENT_ID=sanab-backend
KAFKA_GROUP_ID=sanab-consumers

# ── JWT Authentication ────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-secret-key-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-to-a-secure-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (Media Storage) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Authorize.Net Payment Gateway ─────────────────────────────────
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_ENVIRONMENT=SANDBOX

# ── Twilio SMS ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Gmail SMTP Mailer ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Admin Account Credentials ─────────────────────────────────────
ADMIN_EMAIL=admin@sanab.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://temp-sanab.vercel.app
