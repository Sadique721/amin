# ─────────────────────────────────────────────────────────────────
# SANAB Frontend — Environment Variables (.env.example)
# Copy this to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────

# URL of the Next.js /api/public base — used by the browser axios client.
# Dev:  http://localhost:3000/api/public
# Prod: https://temp-sanab.vercel.app/api/public
NEXT_PUBLIC_API_URL=http://localhost:3000/api/public

# URL of the Express backend — server-only, used by route.ts proxy calls.
# Dev:  http://localhost:2800
# Prod: https://your-express-backend.com
BACKEND_URL=http://localhost:2800

NEXT_PUBLIC_APP_NAME=SANAB
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
