# ─────────────────────────────────────────────────────────────────────────────
# SANAB Frontend — Environment Variables (.env.example)
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to git — they contain real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SANAB

# ── API URLs ──────────────────────────────────────────────────────────────────
# URL the browser uses for all API calls (Next.js /api/public base).
# Dev:  http://localhost:3000/api/public
# Prod: https://your-domain.vercel.app/api/public
NEXT_PUBLIC_API_URL=http://localhost:3000/api/public

# URL of the Express backend (server-side proxy for profile/address endpoints).
# Dev:  http://localhost:2800
# Prod: https://your-express-backend.com  (leave empty if backend not deployed)
BACKEND_URL=http://localhost:2800

# ── Database (Aiven PostgreSQL) ───────────────────────────────────────────────
# Full connection string.  Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://avnadmin:REPLACE_WITH_DB_PASSWORD@your-pg-host.aivencloud.com:13332/defaultdb?sslmode=require

# Optional: provide the CA certificate for Aiven SSL verification.
# Either paste the cert contents (with newlines as \n) OR set the path to the .pem file.
# POSTGRES_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# POSTGRES_CA_PATH=/path/to/ca.pem

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Must match backend/.env exactly — tokens are cross-verified.
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_64_CHAR_HEX_SECRET

# ── Admin Bootstrap ──────────────────────────────────────────────────────────
# Used during DB initialisation to create the first admin account.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ── OTP Email — Resend (Primary, fast) ───────────────────────────────────────
# Get a free API key at https://resend.com → API Keys → Create
# CRITICAL for Vercel: without this, OTP delivery falls back to Gmail SMTP
# which adds 2-3 s latency.  The key MUST start with "re_".
# Set this in Vercel → Project Settings → Environment Variables (Production).
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY

# ── OTP Email — Gmail SMTP (Fallback when Resend is not configured) ───────────
# Use a Gmail App Password (not your account password).
# Generate at: myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Cloudinary (Image Uploads) ────────────────────────────────────────────────
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_API_SECRET
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME

# ── Razorpay (India Payment Gateway) ─────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET

# ── Authorize.Net (Card Payments) ─────────────────────────────────────────────
# Credentials from https://developer.authorize.net
AUTHORIZENET_API_LOGIN_ID=REPLACE_WITH_API_LOGIN_ID
AUTHORIZENET_TRANSACTION_KEY=REPLACE_WITH_TRANSACTION_KEY
AUTHORIZE_NET_API_LOGIN_ID=REPLACE_WITH_API_LOGIN_ID
AUTHORIZE_NET_TRANSACTION_KEY=REPLACE_WITH_TRANSACTION_KEY
# Set to PRODUCTION for live charges, SANDBOX for testing
AUTHORIZE_NET_ENVIRONMENT=SANDBOX

# ── Google OAuth (Login with Google) ─────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs → Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID

# ── CORS (Frontend allowed origins) ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app
